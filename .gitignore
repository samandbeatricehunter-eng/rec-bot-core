node_modules
.pnpm-store
.corepack
dist
.env
.env.*
!.env.example
.DS_Store
*.log

# Hub assets copied into site at Vite build time from apps/web/public
apps/site/public/assets/

# Custom-player card renders (150 PNGs, ~348 MB) are served from Cloudflare Images in
# production — see apps/api/scripts/upload-custom-player-renders.ts. The generator
# (scripts/dev/generate-custom-player-renders.py) still writes here locally for regeneration.
apps/web/public/assets/custom-player-renders/
# Upload manifest written by upload-custom-player-renders.ts (local record, not source).
apps/api/scripts/.custom-player-renders-upload.json

# Tesseract language data (downloaded/bundled at runtime, not source)
*.traineddata
# Local OCR debug scratch output
sea-debug.txt

# madden-ratings-scraper resumable cache (regenerated on demand, can grow to MBs)
apps/api/scripts/.cache/

# Raw Madden 27 EA team-page dumps (large; the compact, committed CSV in
# data/madden27/madden27_ea_players.csv is the seed/crossref input, re-scrape to refresh)
apps/api/scripts/data/madden27/ea/

# Raw QB throwing-motion source clips (~30 MB of .mp4s) are uploaded to Cloudflare Stream --
# see apps/api/scripts/upload-throwing-motions.ts, which regenerates the committed catalog at
# packages/shared/src/immortality/throwing-motions.ts. The clips themselves aren't source.
apps/QB Throwing Motions/

# Raw owner-headshot source renders -- uploaded to the Cloudflare headshot catalog once that
# upload script exists, same pattern as the throwing-motion clips above. Not source.
apps/Owner Headshots/
