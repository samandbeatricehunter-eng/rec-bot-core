{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "playwright-chromium": {
      "inputs": [{ "step": "build" }],
      "commands": [
        "mkdir -p apps/api/node_modules/playwright-core/.local-browsers",
        "PLAYWRIGHT_BROWSERS_PATH=0 pnpm --filter @rec/api exec playwright install --with-deps chromium || echo '[playwright-chromium] install failed or skipped -- deployOutputs still has an (empty) dir to copy so this never fails the build'"
      ],
      "deployOutputs": [{ "include": ["/app/apps/api/node_modules/playwright-core/.local-browsers"] }]
    }
  },
  "deploy": {
    "aptPackages": [
      "libnss3", "libnspr4", "libatk1.0-0", "libatk-bridge2.0-0", "libcups2", "libdrm2",
      "libdbus-1-3", "libxcb1", "libxkbcommon0", "libx11-6", "libxcomposite1", "libxdamage1",
      "libxext6", "libxfixes3", "libxrandr2", "libgbm1", "libpango-1.0-0", "libcairo2",
      "libasound2", "libatspi2.0-0", "fonts-liberation"
    ],
    "variables": {
      "PLAYWRIGHT_BROWSERS_PATH": "0"
    }
  }
}
