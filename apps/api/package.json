{
  "name": "@rec/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/modules/schedule/cfb-launch.test.ts src/modules/subscriptions/billing-policy.test.ts src/modules/league-context/league-games.query.test.ts src/modules/purchases/purchase-deadlines.test.ts src/modules/subscriptions/entitlements.test.ts src/modules/streaming/streaming-labels.test.ts src/modules/scheduling/scheduling-guardrails.test.ts src/modules/madden-ea/ea-datasets.test.ts src/modules/madden-ea/ea-roster-reconcile.test.ts",
    "db:generate": "drizzle-kit generate --config ../../drizzle.config.ts",
    "db:check": "drizzle-kit check --config ../../drizzle.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/websocket": "^11.3.0",
    "@rec/shared": "workspace:*",
    "@supabase/supabase-js": "^2.111.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "jose": "^6.2.4",
    "pg": "^8.22.0",
    "playwright": "^1.49.1",
    "sharp": "^0.35.2",
    "stripe": "^22.3.2",
    "tesseract.js": "^7.0.0",
    "undici": "^6.28.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.3"
  }
}
